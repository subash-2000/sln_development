# Application Configuration
APP_NAME="SLN Warehouse Management System"
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL 17+ via asyncpg)
DATABASE_URL=postgresql+asyncpg://odoo:odoo@localhost:5433/sln_warehouse
TEST_DATABASE_URL=postgresql+asyncpg://odoo:odoo@localhost:5433/sln_warehouse_test
SYNC_DATABASE_URL=postgresql+psycopg2://odoo:odoo@localhost:5433/sln_warehouse

# Security & JWT Authentication
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
